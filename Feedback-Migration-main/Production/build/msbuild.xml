<Project ToolsVersion="4.0" DefaultTargets="PrecompileWeb" 
        xmlns = "http://schemas.microsoft.com/developer/msbuild/2003">
	
		<ItemGroup>
			<ProjectToBuild Include="..\Application\HexFeedback\HexFeedback.sln">
				<Properties>Configuration=Release</Properties>
			</ProjectToBuild>
		</ItemGroup>

		<Target Name="Build">
			<MSBuild Projects="@(ProjectToBuild)"/>
		</Target>

        <Target Name = "PrecompileWeb" DependsOnTargets ="Build">
                <AspNetCompiler
                        VirtualPath = "/" 
                        PhysicalPath = "..\Application\HexFeedback\HexFeedback"
                        TargetPath = "..\PreCompiled"
                        Force = "true"
                        Debug = "false"
                        />
        </Target>
</Project>