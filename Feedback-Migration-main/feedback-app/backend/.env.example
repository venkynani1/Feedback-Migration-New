# Copy to .env and fill in. Every setting is prefixed with FEEDBACK_.

# Long random string used to sign the login cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FEEDBACK_SECRET_KEY=

# ODBC connection string for the TrainingFeedback database. The old Web.config
# used Windows-integrated security against cch1wdsthstg.
FEEDBACK_DB_CONNECTION_STRING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=cch1wdsthstg;DATABASE=TrainingFeedback;Trusted_Connection=yes;TrustServerCertificate=yes

# StationH SOAP authentication service (same endpoint the old app called).
FEEDBACK_SOAP_AUTH_URL=http://che1wpisg18/StationHAuthenticationold/StationHAuthentication.asmx

# "soap" checks passwords against StationH. "dev" accepts any password and is
# only for running locally without access to the service. Never use in production.
FEEDBACK_AUTH_MODE=soap

# Folder the Excel Data Upload page saves files into. SQL Server reads the file
# from this same path, so it must be a share the database server can reach.
# This is the folder the old app used; files are named TrainingFeedback_*.xls
# and removed once imported.
FEEDBACK_UPLOAD_DIR=\\CCH1WPNTDB\StationhReportSource

# true runs on built-in sample data with demo logins (admin, employee,
# supervisor, manager; password "demo"). No database, login service or mail is
# used, and changes are lost on restart. Never enable in production.
FEEDBACK_DEMO_MODE=false

# Set to false only when serving over plain http (local development).
FEEDBACK_COOKIE_SECURE=true
